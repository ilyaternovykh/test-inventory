# =============================================================================
# Пример конфигурации окружения. Скопируйте в .env и заполните своими значениями:
#     cp .env.example .env
# ВНИМАНИЕ: файл .env содержит секреты и НЕ должен попадать в git (.gitignore)!
# =============================================================================

# --- Учётные данные Redfish (общие для всех серверов) ------------------------
# Логин/пароль BMC (iLO / iDRAC / XCC). Для отдельного сервера можно
# переопределить прямо в check_redfish/servers.yaml (поля username/password).
REDFISH_USERNAME=redfish-user
REDFISH_PASSWORD=redfish-password

# --- Расписание ---------------------------------------------------------------
# Интервал полного прохода коллектора по всем серверам, секунд.
# По умолчанию 14400 = 4 часа.
CHECK_INTERVAL=14400

# Интервал цикла синхронизации netbox-sync, секунд.
# По умолчанию 900 = 15 минут.
SYNC_INTERVAL=900

# Задержка перед первым прогоном после старта контейнеров, секунд.
# Даёт коллектору снять первый инвентарь до первой синхронизации.
STARTUP_DELAY=60

# --- NetBox -------------------------------------------------------------------
# FQDN или IP хоста NetBox БЕЗ схемы http(s)://, например netbox.example.com
NBS_NETBOX_HOST_FQDN=netbox.example.com

# REST API токен NetBox (создаётся в NetBox: Profile -> API Tokens -> Add).
# Права: read/write для dcim (devices, module bays/types/modules, interfaces,
# power ports, inventory items), extras (custom fields), tenancy, circuits.
NBS_NETBOX_API_TOKEN=0123456789abcdef0123456789abcdef01234567

# Уровень логирования netbox-sync: DEBUG2 / DEBUG / INFO / WARNING / ERROR
# Для ПЕРВОГО запуска рекомендуется DEBUG2 (максимальная подробность).
NBS_COMMON_LOG_LEVEL=INFO
